rules_version = '2';
// Paste this into Firebase console > Firestore Database > Rules, then Publish.
// Participants (anyone with the site) can only ADD a new response. Nobody can
// read, change or delete responses from the browser; you read them with
// tools/export_responses.py or in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {
    match /responses/{participantId} {
      allow create: if request.resource.data.keys().hasAll(['participant_id', 'trials_csv']);
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
